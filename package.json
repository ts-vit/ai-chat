{
  "name": "uni-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "test": "npm run test -w apps/desktop",
    "test:rust": "cargo test --workspace",
    "test:all": "npm run typecheck -w apps/desktop && npm run test -w apps/desktop && cargo test --workspace"
  }
}
